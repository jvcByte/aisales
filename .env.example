# Every key this project reads. NONE of them are required to run the tests,
# the simulator, or scripts/e2e.py -- the whole system runs offline against
# fakes, on purpose, because there is no WhatsApp access yet and no Paystack
# account. Copy to .env and fill in what you have.

# ── database ────────────────────────────────────────────────────────────────
# Local peer authentication, as everywhere else on this machine.
AISALES_DSN=postgresql:///aisales

# ── the model ───────────────────────────────────────────────────────────────
# Gemini first, then the free tiers behind it. A spent daily allowance is the
# ordinary way this runs rather than an error path, so one key is enough to
# start and four keys is a smoother week.
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=
OPENROUTER_API_KEY=

# Free tiers rename and retire models constantly, so every list is overridable
# rather than needing a code change.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-flash-latest
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# HF_MODELS=meta-llama/Llama-3.3-70B-Instruct
# OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free

# ── payments ────────────────────────────────────────────────────────────────
# Test keys work BEFORE business verification, so the payment path can be
# exercised against real Paystack semantics without real money. The pilot
# business needs CAC registration and a settlement account before it can take
# a naira, and that lead time is outside our control -- start it early.
PAYSTACK_SECRET_KEY=

# ── WhatsApp ────────────────────────────────────────────────────────────────
# Needed only for the Meta adapter. Absent, use the simulator.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ── switches ────────────────────────────────────────────────────────────────
# LEFT OFF ON PURPOSE, and it used to be shipped as 1 which broke the worker
# for anyone who copied this file. 1 means "no real model may be called": the
# tests and the simulator supply their own script, but the worker has nothing
# to fall back on, so it refuses to start. Turn it on only when you are
# deliberately working offline.
# AISALES_FAKES=1

# whatsapp | simulator
AISALES_CHANNEL=simulator

# Where the dashboard finds the API. Baked into the Next rewrite at **build**
# time, so changing it needs `pnpm build` again, not just a restart.
AISALES_API=http://127.0.0.1:8100

# ── tenancy ─────────────────────────────────────────────────────────────────
# Encrypts each business's stored credentials (business_secrets). Generate one
# with:  openssl rand -base64 48
# Changing it makes existing secrets unreadable until they are rotated, which
# is why rows carry a key_version. Leave it unset and nothing can be encrypted
# or read -- there is deliberately no default.
AISALES_SECRET_KEY=

# The role the application connects as. Unset means "run as whoever the DSN
# names", which is only safe while that role is unprivileged -- `db.harden()`
# refuses a superuser, because row level security does not apply to one.
# AISALES_APP_ROLE=aisales_app

# Switches on the operator console at /operator: every business on the
# deployment, onboarding, and suspension. Unset means the console answers 503
# and says so, which is correct for a deployment running one business.
#
# The role this DSN authenticates as must be a member of `aisales_operator`
# (created by --install) or be a superuser: opening a console session runs
# SET ROLE on that connection. If it is not, the error names the GRANT to run.
# AISALES_ADMIN_DSN=postgresql:///aisales
